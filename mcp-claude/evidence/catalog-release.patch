diff --git a/mcp/mutual-fund-mcp/test/mcp-directory.spec.ts b/mcp/mutual-fund-mcp/test/mcp-directory.spec.ts
new file mode 100644
index 0000000..afdb982
--- /dev/null
+++ b/mcp/mutual-fund-mcp/test/mcp-directory.spec.ts
@@ -0,0 +1,70 @@
+import { createExecutionContext, env } from "cloudflare:test";
+import { describe, expect, it } from "vitest";
+import worker from "../src/index";
+import { metricTool } from "../src/usage/buckets";
+
+/** Exercise real Worker discovery and calls with optional local research authentication. */
+async function catalogRequest(method: string, params: Record<string, unknown>, authenticated: boolean) {
+  const response = await worker.fetch(new Request("https://example.com/mcp", {
+    method: "POST",
+    headers: {
+      Accept: "application/json, text/event-stream", "Content-Type": "application/json",
+      ...(authenticated ? { Authorization: "Bearer local:google:alice:hermes:research:read" } : {}),
+    },
+    body: JSON.stringify({ jsonrpc: "2.0", id: 2, method, params }),
+  }), { ...env, DB: undefined, ENVIRONMENT: "local", READ_BACKEND: "d1" } as unknown as Env, createExecutionContext());
+  const text = await response.text();
+  const payload = text.split("\n").find(line => line.startsWith("data:"))?.slice(5) ?? text;
+  return { response, message: JSON.parse(payload) };
+}
+
+describe("retired signal explanation", () => {
+  it.each([false, true])("omits explain_signal from tools/list (authenticated=%s)", async authenticated => {
+    const { response, message } = await catalogRequest("tools/list", {}, authenticated);
+    expect(response.status).toBe(200);
+    expect(message.error).toBeUndefined();
+    const names = message.result.tools.map((tool: { name: string }) => tool.name);
+    expect(names).not.toContain("explain_signal");
+    expect(names).toHaveLength(29);
+    expect(names).toContain("get_index_metrics");
+    expect(names).toContain("get_strategy_portfolio");
+  });
+
+  it("rejects an authenticated direct tools/call to explain_signal as unknown", async () => {
+    const { response, message } = await catalogRequest("tools/call", {
+      name: "explain_signal", arguments: { strategy_id: "factor-momentum", signal_date: "2026-10-30" },
+    }, true);
+    expect(response.status).toBe(200);
+    expect(message.error).toMatchObject({ code: -32602, message: expect.stringMatching(/not found|unknown tool/i) });
+    expect(message.result).toBeUndefined();
+  });
+
+  it("does not classify new usage under the retired tool name", () => {
+    expect(metricTool("explain_signal")).toBe("other");
+    expect(metricTool("get_index_metrics")).toBe("get_index_metrics");
+  });
+});
+
+describe("Claude directory tool discovery", () => {
+  it("advertises titled, bounded-name, read-only tools without authentication", async () => {
+    const response = await worker.fetch(new Request("https://example.com/mcp", {
+      method: "POST",
+      headers: { Accept: "application/json, text/event-stream", "Content-Type": "application/json" },
+      body: JSON.stringify({ jsonrpc: "2.0", id: 1, method: "tools/list", params: {} }),
+    }), { ...env, DB: undefined, ENVIRONMENT: "local", READ_BACKEND: "d1" } as unknown as Env, createExecutionContext());
+    expect(response.status).toBe(200);
+    const text = await response.text();
+    const listed = JSON.parse(text.startsWith("event:") || text.startsWith("data:")
+      ? text.split("\n").find(line => line.startsWith("data:"))!.slice(5)
+      : text);
+    expect(listed.error).toBeUndefined();
+    expect(listed.result.tools.length).toBeGreaterThan(0);
+    for (const tool of listed.result.tools) {
+      expect.soft(tool.title, tool.name).toBeTypeOf("string");
+      expect.soft(typeof tool.title === "string" && tool.title.trim().length > 0, tool.name).toBe(true);
+      expect.soft(tool.name.length, tool.name).toBeLessThanOrEqual(64);
+      expect.soft(tool.annotations?.readOnlyHint, tool.name).toBe(true);
+      expect.soft(tool.annotations?.destructiveHint, tool.name).toBe(false);
+    }
+  });
+});
